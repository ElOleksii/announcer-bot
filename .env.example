# --- Playback -----------------------------------------------------------------
# discord: the bot plays sounds in your Discord voice channel
# local:   sounds play on this PC; Discord is not initialised at all
PLAYBACK_MODE=discord

# --- Discord (required only when PLAYBACK_MODE=discord) -------------------------
# Developer Portal → your application → Bot → Reset Token. Never commit or share it.
DISCORD_TOKEN=
# Developer Portal → your application → General Information → Application ID
DISCORD_CLIENT_ID=
# Your server ID (Discord: Settings → Advanced → Developer Mode, then right-click server → Copy Server ID)
GUILD_ID=

# --- Game State Integration -----------------------------------------------------
# The app listens on 127.0.0.1 only.
GSI_PORT=3000
# Shared secret between Dota and this app, at least 16 chars: letters, digits, "_" or "-".
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# After changing it, run `npm run gen:cfg` and copy the .cfg into Dota again.
GSI_TOKEN=

# --- Announcer ------------------------------------------------------------------
# Max gap between consecutive kills (in game time) for double/triple/ultra/rampage.
MULTIKILL_WINDOW_MS=18000
# Play the "death" sound when you die.
ANNOUNCE_DEATHS=false
# Path to the sounds config (event → files, volume, streak thresholds).
SOUNDS_CONFIG=sounds.config.json

# --- Commentator (AI lines spoken in voice) --------------------------------------
# What plays on kills: sounds | commentator | both. Switch at runtime with /mode.
# commentator/both need ELEVENLABS_API_KEY.
ANNOUNCER_MODE=sounds
# Who writes the lines: templates (built-in, free) | gemini (needs GEMINI_API_KEY).
COMMENTARY_TEXT=templates
# Max time from kill to ready audio; after that the plain sound plays instead.
COMMENTARY_TIMEOUT_MS=6000

# Gemini: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Tried in order when GEMINI_MODEL is overloaded (503) or unavailable; "none" disables.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# ElevenLabs: Profile → API Keys at https://elevenlabs.io (free plan works, non-commercial use)
ELEVENLABS_API_KEY=
# Any voice id from your ElevenLabs "My Voices"; the default is the premade "George".
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_LANGUAGE=uk

# --- Loss analysis ("хто винен") -------------------------------------------------
# After every match the bot fetches stats from OpenDota and scores every teammate by fixed rules:
# blame on a loss, contribution + MVP on a win. The verdict goes to the chat
# (Gemini if GEMINI_API_KEY is set, built-in text otherwise).
# Toggle at runtime with /autoanalyze; run manually with /analyze.
AUTO_ANALYZE=true
# harsh | light — default tone; /analyze tone:… overrides it per call.
ANALYSIS_TONE=harsh
# Your SteamID64 (17 digits, starts with 7656…), so /analyze knows your team even if the bot
# was restarted after the match. GSI provides it too, but only while a game is running.
# Find it on your Steam profile URL or at https://steamid.io
# PLAYER_STEAM_ID=
# Text channel for automatic analyses (right-click the channel → Copy Channel ID).
# Empty: the chat of the bot's voice channel, else the server's system channel.
# ANALYSIS_CHANNEL_ID=

# --- Diagnostics ----------------------------------------------------------------
# Record GSI payloads (when kills/deaths change + every 30s) to an NDJSON file, to see
# which fields Dota sends. The auth token is never written. Leave empty to disable.
# GSI_DUMP_FILE=logs/gsi-dump.ndjson

# --- Logging --------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
