{
  "name": "dota-kill-announcer",
  "version": "0.1.0",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx scripts/simulate-gsi.ts",
    "gen:cfg": "tsx scripts/gen-cfg.ts",
    "gen:sounds": "tsx scripts/gen-placeholders.ts",
    "test:commentary": "tsx scripts/test-commentary.ts",
    "collect": "tsx scripts/collect-matches.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "fit-weights": "tsx scripts/fit-weights.ts"
  },
  "type": "module",
  "description": "Discord bot that announces your Dota 2 kills via Game State Integration",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "fastify": "^5.12.5",
    "ffmpeg-static": "^5.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
